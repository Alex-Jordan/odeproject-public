<prefigure xmlns="https://prefigure.org"
             label="solution-integral-curves-16">

<diagram dimensions="(300,300)" margins="5">
  <definition>f(t,y) = (y^2 - 1)*(y - 2)</definition>
  <coordinates bbox="[-0.25,-2,1.5,2]">
    <grid-axes xlabel="t" ylabel="x"/>
    <de-solve function="f" t0="0" y0="0" t1="4" name="linear"/>
    <plot-de-solution solution="linear" stroke="red"/>
    <plot-de-solution function="f" t0="0" y0="1" t1="4" stroke="blue"/>
    <plot-de-solution function="f" t0="0" y0="-1" t1="4" stroke="green"/>
  </coordinates>
</diagram>
</prefigure>
  
