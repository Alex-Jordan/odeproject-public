<prefigure xmlns="https://prefigure.org"
             label="solution-nullclines-1">

<diagram dimensions="(300,300)" margins="25">
  <definition>f(t,y) = (y[0]*(1 - y[0] + y[1]/2), y[1]*(1 - y[1] + y[0]/2))</definition>
  <coordinates bbox="[0,0,3,3]">
      <definition>gap = 1/4</definition>
    <grid-axes xlabel="x(t)" ylabel="y(t)"/>
    <slope-field function="f" system="yes" stroke="black"
     arrows="yes" thickness="1" spacings="((0,gap,3),(0,gap,3))"/>

    <plot-de-solution function="f" t0="0" t1="20" 
          y0="(2.4,0.3)" axes="(y0,y1)" arrow="yes" stroke="blue"/>

    <point p="(2.4,0.3)" size="4" fill="blue" stroke="none"></point>

    <line endpoints="((0,0), (0,3))" stroke="green"
    thickness="3"/>
    <line endpoints="((1,0), (2.5,3))" stroke="green"
    thickness="3"/>
    <line endpoints="((0,0), (3,0))" stroke="red"
    thickness="3"/>
    <line endpoints="((0,1), (3,2.5))" stroke="red"
    thickness="3"/>
  </coordinates>
  
</diagram>
</prefigure>

