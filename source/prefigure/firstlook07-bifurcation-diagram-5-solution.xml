<prefigure xmlns="https://prefigure.org"
             label="bifurcation-diagram-5-solution">


<diagram dimensions="(300,300)" margins="5">
<definition>g(t)=(t^4, t)</definition>
<definition>h(t)=(t,0)</definition>
  <coordinates bbox="[-2.5,-1.5,2.5,1.5]">
    <grid-axes xlabel="\lambda" ylabel="y"/>

    <group at="solutions">
      <parametric-curve function="g" domain="(-4, 4)"
          stroke="blue" thickness="3"/>
        <parametric-curve function="h" domain="(-4, 4)"
          stroke="blue" thickness="3"/>

          <line endpoints="((-2,-1.5),(-2,1.5))" stroke="red" thickness="2" />
          <line endpoints="((-2,6),(-2,1))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((-2,-1.5),(-2,-1))" stroke="red" thickness="2" arrows="1"/>

          <line endpoints="((-1,-1.5),(-1,1.5))" stroke="red" thickness="2" />
          <line endpoints="((-1,6),(-1,1))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((-1,-1.5),(-1,-1))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((-1,-1.5),(-1,5))" stroke="red" thickness="2" arrows="1"/>

          <line endpoints="((0,-1.5),(0,1.5))" stroke="red" thickness="2" />
          <line endpoints="((0,6),(0,1))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((0,-1.5),(0,-1))" stroke="red" thickness="2" arrows="1"/>

          <line endpoints="((1,-1.5),(1,1.5))" stroke="red" thickness="2" />
          <line endpoints="((1,1.5),(1,1.25))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((1,-1.5),(1,-1.25))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((1,0),(1,0.5))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((1,0),(1,-0.5))" stroke="red" thickness="2" arrows="1"/>

          <line endpoints="((2,-1.5),(2,1.5))" stroke="red" thickness="2" />
          <line endpoints="((2,1.5),(2,1.25))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((2,-1.5),(2,-1.25))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((2,0),(2,0.5))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((2,0),(2,-0.5))" stroke="red" thickness="2" arrows="1"/>

          <point p="(0,0)" size="5"> </point>
          <point p="(1,0)" size="5"> </point>
          <point p="(-1,0)" size="5"> </point>
          <point p="(2,0)" size="5"> </point>
          <point p="(-2,0)" size="5"> </point>
          <point p="(1,1)" size="5"> </point>
          <point p="(1,-1)" size="5"> </point>
          <point p="(2,2^(1/4))" size="5"> </point>
          <point p="(2,-2^(1/4))" size="5"> </point>

    </group>


  </coordinates>

</diagram>
</prefigure>
  
