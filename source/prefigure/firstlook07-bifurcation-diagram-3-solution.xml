<prefigure xmlns="https://prefigure.org"
             label="bifurcation-diagram-3-solution">


<diagram dimensions="(300,300)" margins="5">
<definition>g(t)=(-t^2 + 2*t, t)</definition>
  <coordinates bbox="[-2.5,-2,2.5,4]">
    <grid-axes xlabel="y" ylabel="\lambda"/>

    <group at="solutions">
      <parametric-curve function="g" domain="(-4, 4)"
          stroke="blue" thickness="3"/>

          <line endpoints="((-2,-2),(-2,4))" stroke="red" thickness="2" />
          <line endpoints="((-2,4),(-2,1))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((-2,-2),(-2,3.5))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((-2,-2),(-2,-1.5))" stroke="red" thickness="2" arrows="1"/>

          <line endpoints="((-1,-2),(-1,4))" stroke="red" thickness="2" />
          <line endpoints="((-1,4),(-1,1))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((-1,-2),(-1,3.5))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((-1,-2),(-1,-1.5))" stroke="red" thickness="2" arrows="1"/>

          <line endpoints="((0,-2),(0,4))" stroke="red" thickness="2" />
          <line endpoints="((0,4),(0,1))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((0,-2),(0,3.5))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((0,-2),(0,-1.5))" stroke="red" thickness="2" arrows="1"/>

          <line endpoints="((1,-2),(1,4))" stroke="red" thickness="2" />
          <line endpoints="((1,-2),(1,-1))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((1,-2),(1,3))" stroke="red" thickness="2" arrows="1"/>         

          <line endpoints="((2,-2),(2,4))" stroke="red" thickness="2" />
          <line endpoints="((2,-2),(2,1))" stroke="red" thickness="2" arrows="1"/>

          <point p="(1,1)" size="5"> </point>
          <point p="(0,0)" size="5"> </point>
          <point p="(0,2)" size="5"> </point>
          <point p="(-1,1 + sqrt(2))" size="5"> </point>
          <point p="(-1,1 - sqrt(2))" size="5"> </point>
          <point p="(-2,1/sqrt(2)+2)" size="5"> </point>
          <point p="(-2,-1/sqrt(2))" size="5"> </point>
    </group>


  </coordinates>

</diagram>
</prefigure>
  
