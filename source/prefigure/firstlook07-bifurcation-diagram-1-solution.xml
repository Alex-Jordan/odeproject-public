<prefigure xmlns="https://prefigure.org"
             label="bifurcation-diagram-1-solution">


<diagram dimensions="(300,300)" margins="5">
<definition>g(t)=(t^2, t)</definition>
  <coordinates bbox="[-2.5,-3,2.5,3]">
    <grid-axes xlabel="\lambda" ylabel="y"/>

    <group at="solutions">
      <parametric-curve function="g" domain="(-4, 4)"
          stroke="blue" thickness="3"/>

          <line endpoints="((-2,-3),(-2,3))" stroke="red" thickness="2" />
          <line endpoints="((-2,3),(-2,0))" stroke="red" thickness="2" arrows="1"/>

          <line endpoints="((-1,-3),(-1,3))" stroke="red" thickness="2" />
          <line endpoints="((-1,3),(-1,0))" stroke="red" thickness="2" arrows="1"/>

          <line endpoints="((0,-3),(0,3))" stroke="red" thickness="2" />
          <line endpoints="((0,3),(0,1.5))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((0,3),(0,-1.5))" stroke="red" thickness="2" arrows="1"/>

          <line endpoints="((1,-3),(1,3))" stroke="red" thickness="2" />
          <line endpoints="((1,-3),(1,0))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((1,3),(1,2))" stroke="red" thickness="2" arrows="1"/>         
          <line endpoints="((1,3),(1,-2))" stroke="red" thickness="2" arrows="1"/>

          <line endpoints="((2,-3),(2,3))" stroke="red" thickness="2" />
          <line endpoints="((2,-3),(2,0))" stroke="red" thickness="2" arrows="1"/>
          <line endpoints="((2,3),(2,2))" stroke="red" thickness="2" arrows="1"/>         
          <line endpoints="((2,3),(2,-2))" stroke="red" thickness="2" arrows="1"/>

          <point p="(0,0)" size="5"> </point>
          <point p="(1,1)" size="5"> </point>
          <point p="(1,-1)" size="5"> </point>
          <point p="(2,-sqrt(2))" size="5"> </point>
          <point p="(2,sqrt(2))" size="5"> </point>

    </group>


  </coordinates>

</diagram>
</prefigure>
  
