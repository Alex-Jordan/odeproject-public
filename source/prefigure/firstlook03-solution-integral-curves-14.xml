<prefigure xmlns="https://prefigure.org"
             label="solution-integral-curves-14">

<diagram dimensions="(300,300)" margins="5">
  <definition>f(t,y) = 2*y-5</definition>
  <coordinates bbox="[-0.25,-5,1.5,8]">
    <grid-axes xlabel="t" ylabel="y"/>
    <de-solve function="f" t0="0" y0="0" t1="4" name="linear"/>
    <plot-de-solution solution="linear" stroke="red"/>
    <plot-de-solution function="f" t0="0" y0="2" t1="4" stroke="blue"/>
    <plot-de-solution function="f" t0="0" y0="4" t1="4" stroke="green"/>
  </coordinates>
</diagram>
</prefigure>
  
